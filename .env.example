# SMTP Email Server Configuration (Esqueceu a Senha / Recuperação / Notificações)
# Para configurar o Mailtrap SMTP (live.smtp.mailtrap.io):
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=api
# SMTP_PASS=<SEU_API_TOKEN_DO_MAILTRAP>
# SMTP_FROM="Magic Elves <hello@amplificagroup.com>"
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=api
SMTP_PASS=
SMTP_FROM="Magic Elves <hello@amplificagroup.com>"
