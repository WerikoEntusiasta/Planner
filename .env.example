# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=https://planner.amplificagroup.com

# Admin Dashboard Access Credentials
VITE_ADMIN_EMAIL=admin@saas.com
VITE_ADMIN_PASSWORD=admin123

# Stripe Payment Gateway Credentials
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (BRL)
STRIPE_PRICE_STARTER_MONTHLY_BRL=
STRIPE_PRICE_STARTER_QUARTERLY_BRL=
STRIPE_PRICE_BASIC_MONTHLY_BRL=
STRIPE_PRICE_BASIC_QUARTERLY_BRL=
STRIPE_PRICE_PRO_MONTHLY_BRL=
STRIPE_PRICE_PRO_QUARTERLY_BRL=
STRIPE_PRICE_GROWTH_MONTHLY_BRL=
STRIPE_PRICE_GROWTH_QUARTERLY_BRL=

# Stripe Price IDs (USD)
STRIPE_PRICE_STARTER_MONTHLY_USD=
STRIPE_PRICE_STARTER_QUARTERLY_USD=
STRIPE_PRICE_BASIC_MONTHLY_USD=
STRIPE_PRICE_BASIC_QUARTERLY_USD=
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_PRO_QUARTERLY_USD=
STRIPE_PRICE_GROWTH_MONTHLY_USD=
STRIPE_PRICE_GROWTH_QUARTERLY_USD=

# Meta (Facebook/Instagram) Developer Credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMTP Email Server Configuration (Esqueceu a Senha / Recuperação / Notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua-senha-de-aplicativo
SMTP_FROM="Planner de Conteúdo <noreply@amplificagroup.com>"
